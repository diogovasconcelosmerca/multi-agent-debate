# Copy this file to .streamlit/secrets.toml and fill in your values.
# .streamlit/secrets.toml is gitignored — your keys never reach the repo.
#
# For Streamlit Cloud: add these in the app's Settings → Secrets
# instead (don't ship secrets.toml to the deploy).

GROQ_API_KEY   = "gsk_your_key_here"          # https://console.groq.com
GEMINI_API_KEY = "AIzaSy_your_key_here"       # https://aistudio.google.com/app/apikey
